@PACKAGE_INIT@

# LogosDesignSystem package config — makes the STATIC qt_add_qml_module targets
# (Logos.Theme, Logos.Icons, Logos.Controls) plus the Logos::DesignSystem
# umbrella INTERFACE library discoverable via
#   find_package(LogosDesignSystem CONFIG REQUIRED)
# Consumers then do:
#   target_link_libraries(<app> PRIVATE Logos::DesignSystem)
#   qt_import_qml_plugins(<app>)
# and `import Logos.Theme` / .Controls / .Icons resolves from embedded qrc.

include(CMakeFindDependencyMacro)
find_dependency(Qt6 REQUIRED COMPONENTS Core Qml Quick QuickControls2)

include("${CMAKE_CURRENT_LIST_DIR}/LogosDesignSystemTargets.cmake")

check_required_components(LogosDesignSystem)
